{
  "name": "doc-scanner",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Phone-camera document scanner PWA that produces clean, searchable, small PDFs for a self-hosted Paperless-ngx instance.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:quick": "node tests/e2e/run.mjs --only letter_a4,receipt,faded,flyer_blue,photos,pinboard,ruled_close,scan_150dpi,rot90,coloured_text --no-ocr --no-clean-ocr --no-ui",
    "e2e:ocr": "node tests/e2e/run.mjs --only letter_a4,german,receipt,low_light --no-clean-ocr --no-ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
